# Application
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_NAME=rcthub

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRY_HOURS=168

# osu! OAuth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=http://localhost:8090/auth/osu/callback
OSU_API_BASE=https://osu.ppy.sh

# CORS
ALLOWED_ORIGINS=http://localhost:3000
